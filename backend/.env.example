# PayPal partner REST app (SANDBOX ONLY). Partner credentials live here and nowhere else.
PAYPAL_PARTNER_CLIENT_ID=
PAYPAL_PARTNER_CLIENT_SECRET=
# The partner account's own PayPal merchant (payer) ID, used for merchant-integrations lookups.
PAYPAL_PARTNER_MERCHANT_ID=
# Webhook ID from the partner app's webhook settings (needed only if you receive webhooks).
PAYPAL_WEBHOOK_ID=

# Supabase (values printed by `supabase start`).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Leave empty to verify user tokens against the project's JWKS; set it for HS256 projects.
SUPABASE_JWT_SECRET=

# Approval tokens: at least 32 random characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APPROVAL_SIGNING_KEY=
APPROVAL_TOKEN_TTL_SECONDS=600

# Gemini. Without a key the agent uses its rules-based recommendation and template notes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

FRONTEND_URL=http://localhost:3000
POLL_INTERVAL_MINUTES=15
