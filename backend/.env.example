# PayPal partner REST app (SANDBOX ONLY). Partner credentials live here and nowhere else.
PAYPAL_PARTNER_CLIENT_ID=
PAYPAL_PARTNER_CLIENT_SECRET=
# The partner account's own PayPal merchant (payer) ID, used for merchant-integrations lookups.
PAYPAL_PARTNER_MERCHANT_ID=
# Webhook ID from the partner app's webhook settings (only needed to receive webhooks; leave empty).
PAYPAL_WEBHOOK_ID=
# Developer-only: use the partner app's own sandbox business account as the merchant while partner
# onboarding is not yet approved by PayPal. Never enable outside the sandbox.
PAYPAL_DEV_SELF_MERCHANT=false

# Hosted Supabase (supabase.com). No Docker or local database needed.
# Session pooler string (port 5432), with YOUR-PASSWORD left as-is, for example:
# postgresql://postgres.abcd1234:YOUR-PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# The real database password; it replaces YOUR-PASSWORD above (symbols are fine).
DATABASE_PASSWORD=
# Project URL, for example https://abcd1234.supabase.co
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Leave empty to verify user tokens against the project's JWKS; set it for HS256 projects.
SUPABASE_JWT_SECRET=

# Approval tokens: at least 32 random characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APPROVAL_SIGNING_KEY=
APPROVAL_TOKEN_TTL_SECONDS=600
# Key for the HMAC-chained audit log (at least 32 characters). Leave empty to reuse APPROVAL_SIGNING_KEY.
AUDIT_CHAIN_KEY=

# Gemini. Without a key the agent uses its rules-based recommendation and template notes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used automatically when the main model is overloaded or out of quota.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

FRONTEND_URL=http://localhost:3000
POLL_INTERVAL_MINUTES=15

# Hosting (docs/SETUP.md, "Host it for judges"). Leave these empty for local development.
# Run the job worker inside the API process, for hosts with one free web service (Render).
RUN_WORKER_IN_PROCESS=false
# Shared judge login. Empty DEMO_EMAIL turns the demo features off.
DEMO_EMAIL=
# Only read by `uv run python -m app.demo` when it creates the login; never needed on the server.
DEMO_PASSWORD=
# Four sandbox business account emails: operating, tax reserve, dispute buffer, ad spend.
DEMO_ACCOUNT_EMAILS=
DEMO_RESET_HOUR_UTC=3
LLM_REQUESTS_PER_10_MINUTES=20

# Sandbox/testing only: create sign-ups already confirmed (no email), avoiding Supabase's email rate limit.
AUTO_CONFIRM_SIGNUPS=false
